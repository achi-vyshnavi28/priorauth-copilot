  {
   "name": "Queue",
   "item": [
    {
     "name": "TC11 Clinician queue holds only pended cases, oldest first",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/cases?status=pending_review",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "cases"
       ],
       "query": [
        {
         "key": "status",
         "value": "pending_review"
        }
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Clinician queue holds only pended cases, oldest first\", function () {",
         "    const q = pm.response.json();",
         "    pm.expect(q.length).to.be.above(0);",
         "    q.forEach(c => pm.expect(c.status).to.eql('pending_review'));",
         "    const t = q.map(c => c.received_at);",
         "    pm.expect(t).to.eql([...t].sort());",
         "    pm.collectionVariables.set('pendedCase', q[0].case_id);",
         "});"
        ]
       }
      }
     ]
    },
    {
     "name": "TC12 A typo in the status filter is an error, not an empty queue",
