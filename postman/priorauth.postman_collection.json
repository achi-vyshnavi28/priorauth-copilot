        "exec": [
         "pm.test(\"Statistics are consistent with the queue\", function () {",
         "    const s = pm.response.json();",
         "    pm.expect(s.auto_approval_rate).to.be.within(0, 1);",
         "    const n = Object.values(s.by_status).reduce((a, b) => a + b, 0);",
