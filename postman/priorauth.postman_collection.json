   "key": "newCase",
   "value": ""
  },
  {
   "key": "pendedCase",
   "value": ""
  }
 ],
 "item": [
  {
   "name": "Health",
   "item": [
    {
     "name": "TC01 Service is up",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/health",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "health"
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Service is up\", function () {",
         "    pm.response.to.have.status(200);",
         "    pm.expect(pm.response.json().status).to.eql('ok');",
         "});"
        ]
       }
      }
     ]
    },
    {
     "name": "TC02 Every response carries a request id for support tickets",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/health",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "health"
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Every response carries a request id for support tickets\", function () {",
         "    pm.expect(pm.response.headers.get('x-request-id')).to.match(/^[0-9a-f]{12}$/);",
         "});"
        ]
       }
      }
     ]
    }
   ]
  },
  {
   "name": "Policies",
   "item": [
    {
     "name": "TC03 Both CMS policies are served with their criteria",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/policies",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "policies"
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Both CMS policies are served with their criteria\", function () {",
         "    const p = pm.response.json();",
         "    pm.expect(p.map(x => x.ncd).sort()).to.eql(['100.1', '240.4']);",
         "    p.forEach(x => pm.expect(x.criteria.length).to.be.above(0));",
         "});"
        ]
       }
      }
     ]
    }
   ]
