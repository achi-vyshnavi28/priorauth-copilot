       "path": [
        "cases",
        "{{newCase}}"
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"The new case can be read back with its audit trail\", function () {",
         "    pm.response.to.have.status(200);",
         "    const c = pm.response.json();",
         "    pm.expect(c.audit[0].action).to.eql('received');",
         "    pm.expect(c.documents.length).to.eql(1);",
         "});"
        ]
       }
      }
     ]
